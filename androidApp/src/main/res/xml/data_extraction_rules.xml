<?xml version="1.0" encoding="utf-8"?>
<!-- Vault data lives in noBackupFilesDir (never backed up). Preferences such as favorites and
     theme are backed up; cached share copies are not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
